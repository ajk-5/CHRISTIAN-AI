{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Frontend && npm install",
  "buildCommand": "cd Frontend && npm run build",
  "outputDirectory": "Frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{donnees/**,donnees_complementaires/**,equipe/**,kit/**,traces/**,equipe.toml}",
      "excludeFiles": "{Frontend/**,.venv/**,.pytest_cache/**,kit/tests/**,equipe/tests/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
